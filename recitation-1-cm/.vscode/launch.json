{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "(gdb) Launch employee",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/employee",
      "args": [
        "${workspaceFolder}/employees.txt"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Set disassembly flavor to Intel",
          "text": "-gdb-set disassembly-flavor intel",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "build"
    }
  ]
}