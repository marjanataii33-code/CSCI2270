{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "mkdir -p ${workspaceFolder}/build && g++ -g -O0 -std=c++11 -Wall -o ${workspaceFolder}/build/employee ${workspaceFolder}/main.cpp ${workspaceFolder}/addEmployee.cpp",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "clean",
      "type": "shell",
      "command": "rm -rf ${workspaceFolder}/build",
      "problemMatcher": []
    }
  ]
}